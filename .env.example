# 仅包含安全默认值；复制为 .env 后再按本机环境调整。
SDW_HOST=127.0.0.1
SDW_PORT=7860
SDW_DEVICE=auto
SDW_LOG_LEVEL=info

# 建议使用仓库外的绝对路径；setup 将生成本机配置。
SDW_DATA_DIR=
SDW_MODELS_DIR=
SDW_OUTPUTS_DIR=
SDW_CACHE_DIR=
SDW_UPSTREAM_DIR=

SDW_UPSTREAM_REPOSITORY=https://github.com/AUTOMATIC1111/stable-diffusion-webui.git
SDW_RELEASE_CHANNEL=stable
# 由经过验证的 upstream lock 写入，不跟踪浮动分支。
SDW_UPSTREAM_REF=
